# Represents the Queries record for the operation: listNotarizationRequests
public type ListNotarizationRequestsQueries record {
    # Number of results to skip
    @constraint:Int {minValue: 0}
    int offset = 0;
    # Maximum number of results to return
    @constraint:Int {minValue: 1, maxValue: 100}
    int 'limit = 50;
    # Sort field. Use a `-` prefix for descending order (e.g., `-date_created`).
    # When omitted, results are sorted by `date_created` ascending (oldest first)
    @http:Query {name: "order_by"}
    "status"|"-status"|"date_created"|"-date_created"|"date_completed"|"-date_completed" orderBy = "date_created";
    # Filter by document ID (comma-separated values supported)
    @http:Query {name: "document_id"}
    string[] documentId?;
    # Filter by creator user ID (comma-separated values supported)
    @http:Query {name: "created_by_user_id"}
    string[] createdByUserId?;
    # Filter by status (comma-separated values supported)
    @constraint:Array {maxLength: 10}
    ("DRAFT"|"SENT"|"WAITING_FOR_NOTARY"|"ACCEPTED"|"LIVE"|"COMPLETED"|"INCOMPLETE"|"CANCELLED")[] status?;
};

