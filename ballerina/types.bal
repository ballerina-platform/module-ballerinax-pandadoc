# Update a recipient group's name and/or its members. Provide at least one
# of `name` or `members`.
# 
# When `members` is sent, it **replaces** the group's current membership:
# members not present in the list are removed from the group, and any new
# members are added. On a sent document, newly added members are notified
# and removed members lose access. Members are matched by `email`; for a
# retained member, only the contact fields you include (`first_name`,
# `last_name`) are updated, and omitted fields keep their existing values
public type DocumentRecipientGroupEditRequest record {
    # The full list of members the group should contain after the update. Must contain at least one member when provided
    @constraint:Array {minLength: 1}
    DocumentRecipientGroupEditMember[] members?;
    # New name for the recipient group
    @constraint:String {maxLength: 120}
    string name?;
};

