    # The quote this result corresponds to. Echoed from the request
    string id;
    # Per-quote outcome discriminator. `ok`, `validation_error`, `not_in_document`, `not_found`, and `conflict` mirror the single-quote update endpoint's `200`/`400`/`403`/`404`/`409` responses respectively — see each variant's own schema. `internal_error` is exclusive to the batch endpoint and indicates an isolated server-side failure for that quote only; the request as a whole succeeded and other quotes in the same batch are unaffected
    QuotesBatchUpdateResultStatus status;
};

