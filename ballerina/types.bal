# Recipient
public type RecipientAssignedTo record {
    *RecipientAssignmentDetails;
    # Methods used to deliver the document to the recipient
    @jsondata:Name {value: "delivery_methods"}
    AssignedToRecipientDeliveryMethods deliveryMethods?;
    # Redirect settings applied after the recipient completes the document
    RecipientRedirectSettings redirect?;
    # Role assigned to the recipient
    string role?;
    # Phone number of the recipient
    string phone?;
    # Last name of the recipient
    @jsondata:Name {value: "last_name"}
    string lastName?;
    # Assignee type. Always `recipient` for an individual recipient
    "recipient" 'type?;
    # First name of the recipient
    @jsondata:Name {value: "first_name"}
    string firstName?;
};

# Price settings if the price is not flat rate. If it is null, the price is flat rate
public type QuoteUpdateRequestPriceSettings record {
    # Price tiers for volume or tiered pricing
    QuoteUpdateRequestPriceSettingsTiers[] tiers;
    # Base value for volume discount pricing. If set, tiers are treated like percentage of discount on this value. If not set, tiers are treated like a flat value discount of chosen currency
    @jsondata:Name {value: "base_value"}
    decimal? baseValue;
};
