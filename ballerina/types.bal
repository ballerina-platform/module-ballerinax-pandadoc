# Section settings. Denotes whether a section is optional or selected, and selection type inside the section - single, multiple, or custom
public type QuoteUpdateRequestSettings record {
    # How items inside the section can be selected: single, multiple or custom
    @jsondata:Name {value: "selection_type"}
    QuoteUpdateRequestSettingsSelectionTypeTypeEnum selectionType?;
    # Whether the section is optional for the recipient
    boolean optional?;
    # Whether the section is selected
    boolean selected?;
};

