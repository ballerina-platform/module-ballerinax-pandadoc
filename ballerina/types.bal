    decimal price = 0;
    # Item QTY. If you create an item without providing a value, it will have the default value
    int qty = 1;
    # Item name. If you create an item without providing a value, it will have the default value
    string name = "";
    # Denotes whether an item is selected, optional, and has editable quantity
    QuoteUpdateRequestOptions options?;
    # Item multipliers
