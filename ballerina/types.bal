};

# Represents the Queries record for the operation: uploadSectionFromFile
public type UploadSectionFromFileQueries record {
    # Determines how the fields are mapped when creating a section.
    #   * document: Default value. The fields of the entire document are updated.
    #   * upload: Only the fields from the created section are updated. The merge field is appended with the upload ID
    @http:Query {name: "merge_field_scope"}
    "document"|"upload" mergeFieldScope?;
};

public type DocumentSendManualReminder200ResponseSms record {
    # Timestamp of when the reminder was sent, in ISO 8601 format. Present only on success
    @jsondata:Name {value: "sent_at"}
    string? sentAt?;
    # Detailed explanation of why the reminder could not be sent. Present only on error
    "Can't send reminder to CC recipient"|"Can't send reminder to the Recipient who completed their part"|"Can't send reminder. Signing order is enabled and this Recipient can't sign the document yet"|"Can't send reminder. SMS delivery method is not selected for recipient"|"Can't send SMS reminder to recipient group"|"Can't send SMS reminder. Confirmation of recipient consent is required. Admin should access workspace settings to certify"|"Can't send SMS reminder to the Recipient more than once every 24 hours"|"Can't send SMS reminder to the Recipient with no phone number"|"Can't send SMS reminder to the Recipient with invalid phone number"|"Can't send reminder. The document does not contain a recipient with the specified recipient ID"? detail?;
    # Status of the SMS reminder attempt (sent or error)
    "sent"|"error" status?;
};

