};

# Document settings response
public type DocumentSettingsResponse record {
    # Document language code (e.g., 'en-US', 'fr-FR')
    DocumentLanguageEnum language;
    # Indicates whether the document requires a Qualified Electronic Signature (QES)
    # during the signing process. If `true`, signers must complete the document using
    # a third-party qualified electronic signature provider according to supported verification rules
    @jsondata:Name {value: "qualified_electronic_signature"}
    boolean qualifiedElectronicSignature;
    # Document expiration in days. If not explicitly set, defaults to the system default expiration
    @jsondata:Name {value: "expires_in"}
    int:Signed32 expiresIn;
    # Indicates whether Suggest Edits (redlining) is enabled for the document. When `true`,
    # recipients can suggest edits to the document content during the signing process
    @jsondata:Name {value: "suggest_edits"}
    boolean suggestEdits;
};

