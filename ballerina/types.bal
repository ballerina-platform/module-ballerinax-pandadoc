# Effective privacy settings for a workspace. Compliance flags and
# on-premises training are read-only on this API
public type PrivacySettings record {
    # Workspace id
    @jsondata:Name {value: "workspace_id"}
    string workspaceId;
    # Master switch for AI features in the workspace
    @jsondata:Name {value: "ai_features_enabled"}
    boolean aiFeaturesEnabled;
    # Whether PandaDoc-operated model training is enabled
    @jsondata:Name {value: "ai_on_premises_training_enabled"}
    boolean aiOnPremisesTrainingEnabled;
    # Whether third-party model training is enabled
    @jsondata:Name {value: "ai_third_party_training_enabled"}
    boolean aiThirdPartyTrainingEnabled;
    # Whether 21 CFR Part 11 compliance is enabled for the workspace
    @jsondata:Name {value: "cfr11_compliance_enabled"}
    boolean cfr11ComplianceEnabled;
    # Whether HIPAA compliance is enabled for the workspace. When
    # `true`, every AI setting is forced off
    @jsondata:Name {value: "hipaa_compliance_enabled"}
    boolean hipaaComplianceEnabled;
    # Whether PandaDoc-operated AI processing is enabled
    @jsondata:Name {value: "ai_on_premises_processing_enabled"}
    boolean aiOnPremisesProcessingEnabled;
    # Whether third-party cloud AI processing is enabled
    @jsondata:Name {value: "ai_cloud_third_party_enabled"}
    boolean aiCloudThirdPartyEnabled;
};

