# Per-quote outcome discriminator. `ok`, `validation_error`, `not_in_document`, `not_found`, and `conflict` mirror the single-quote update endpoint's `200`/`400`/`403`/`404`/`409` responses respectively — see each variant's own schema. `internal_error` is exclusive to the batch endpoint and indicates an isolated server-side failure for that quote only; the request as a whole succeeded and other quotes in the same batch are unaffected
public type QuotesBatchUpdateResultStatus "ok"|"validation_error"|"not_in_document"|"not_found"|"conflict"|"internal_error";

public type DocumentCreateByTemplateRequestFields record {
    # Assign this field to a recipient role. The role must be present in the `recipients` list
    string role?;
    # The value to pre-fill the field with. The type of the value depends on the field type in the template.
    # For example, for a checkbox field, you can pass a boolean value, and for a date field, you can pass a date string in RFC 3339 format (e.g., 2019-12-31T00:00:00.000Z)
    boolean|string|decimal value;
};

public type AddMemberResponse record {
    @jsondata:Name {value: "member_id"}
    string memberId?;
    @jsondata:Name {value: "workspace_id"}
    string workspaceId?;
    # Role for a member
    WorkspaceMemberRoleEnum role?;
    @jsondata:Name {value: "last_name"}
    string lastName?;
    @jsondata:Name {value: "first_name"}
    string firstName?;
    string email?;
};

# Set specific values to the fields. This object maps merge field names to their corresponding values.
# 
# Each key represents a merge field name, and each value is an object containing the data to populate that field with. The structure allows you to pre-populate various field types including text inputs, checkboxes, dropdowns, and date fields.
# 
# **Key Points:**
# - Keys must match the exact merge field names from your template or file.
# - Values must be wrapped in an object with a `value` property.
# - Supported value types: string, number, boolean.
# - Date fields should use RFC 3339 format (e.g., '2019-12-31T00:00:00.000Z').
# - Signature fields cannot be pre-filled.
# 
# **Example Usage:**
# - Text field: `"CustomerName": {"value": "John Doe"}`
# - Checkbox: `"AgreeToTerms": {"value": true}`
# - Date field: `"DeliveryDate": {"value": "2019-12-31T00:00:00.000Z"}`
public type DocumentUpdateRequestField record {|
    record {boolean|string|decimal value;}...;
|};

