# To set up recipient verification, provide verification_place (required) and exactly one verification type: passcode_verification, phone_verification, kba_verification, id_verification, or email_otp_verification. All other verification type fields must be null. Providing more than one verification type returns a 400 error.
# - For passcode_verification, provide the passcode.
# - For phone_verification, provide the phone_number.
# - For email_otp_verification, provide the email.
# - For kba_verification and id_verification, set the enabled parameter to true
public type RecipientVerificationSettings record {
    # Sets the KBA verification
    @jsondata:Name {value: "kba_verification"}
    RecipientVerificationSettingsKbaVerification? kbaVerification?;
    # Sets the passcode
    @jsondata:Name {value: "passcode_verification"}
    RecipientVerificationSettingsPasscodeVerification? passcodeVerification?;
    # Sets the email address to send a one-time passcode to
    @jsondata:Name {value: "email_otp_verification"}
    RecipientVerificationSettingsEmailOtpVerification? emailOtpVerification?;
    # Sets the ID verification
    @jsondata:Name {value: "id_verification"}
    RecipientVerificationSettingsIdVerification? idVerification?;
    # Point in the signing flow at which the recipient is verified
    @jsondata:Name {value: "verification_place"}
    RecipientVerificationPlaceEnum verificationPlace?;
    # Sets the phone number to send a passcode to
    @jsondata:Name {value: "phone_verification"}
    RecipientVerificationSettingsPhoneVerification? phoneVerification?;
};

